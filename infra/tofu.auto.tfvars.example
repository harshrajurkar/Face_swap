aws_region            = "us-east-1"
project_name          = "ai-face-swap"
environment           = "dev"

public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24"]
private_app_subnet_cidrs  = ["10.20.11.0/24", "10.20.12.0/24"]
private_data_subnet_cidrs = ["10.20.21.0/24", "10.20.22.0/24"]

# Fix: InsightFace/worker model loading is too heavy for t3.micro and can crash-loop.
app_instance_type     = "t3.small"
app_root_volume_size  = 50
app_directory         = "/opt/ai-face-swap"
app_repo_url          = "https://github.com/your-org/your-repo.git"
# Fix: keep EC2 deploy script synced with the branch CI/CD deploys.
app_repo_branch       = "v1.0.32"

# Fix: use the same split ECR repos that the GitHub Actions workflow updates.
frontend_image_uri = "<aws-account-id>.dkr.ecr.us-east-1.amazonaws.com/ai-face-swap-frontend:latest"
backend_image_uri  = "<aws-account-id>.dkr.ecr.us-east-1.amazonaws.com/ai-face-swap-backend:latest"

execution_provider          = "CPUExecutionProvider"
worker_concurrency          = 1
worker_job_timeout_seconds  = 900
worker_max_retries          = 2

redis_node_type       = "cache.t4g.micro"
redis_engine_version  = "7.1"
redis_use_tls         = true

enable_https       = false
acm_certificate_arn = null

tags = {
  Owner = "your-name"
}
