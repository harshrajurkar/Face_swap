#!/bin/bash
set -eux

# Update
apt-get update -y

# Install prerequisites
apt-get install -y ca-certificates curl gnupg lsb-release awscli git

# Add Docker GPG key
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
  gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

# Add Docker repo
echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
  https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo $VERSION_CODENAME) stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null

# Install Docker + Compose v2
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Start Docker
systemctl enable docker
systemctl start docker

# Create app dir
mkdir -p /opt/ai-face-swap
cd /opt/ai-face-swap

# Clone repo (first time)
if [ ! -d "app" ]; then
  git clone https://github.com/harshrajurkar/Face_swap.git app
fi

# Copy AWS-specific compose file
cp app/docker-compose.aws.yml app/docker-compose.yml