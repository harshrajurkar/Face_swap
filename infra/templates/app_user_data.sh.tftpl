#!/bin/bash
set -euxo pipefail

exec > >(tee /var/log/user-data.log)
exec 2>&1

echo "========== MINIMAL USER DATA START =========="
echo "Started at: $(date)"

export DEBIAN_FRONTEND=noninteractive
APP_DIR="${app_dir}"
APP_REPO_DIR="${app_dir}/app"

echo "APP_DIR=${app_dir}"
echo "APP_REPO_DIR=${app_dir}/app"
echo "REPO=${app_repo_url}@${app_repo_branch}"

echo "Installing minimal prerequisites (git)..."
for i in 1 2 3; do
  apt-get update -y && apt-get install -y git && break
  echo "Retry $i failed... retrying in 10s"
  sleep 10
done

mkdir -p "$APP_DIR"

if [ -d "$APP_REPO_DIR/.git" ]; then
  echo "Refreshing existing repository..."
  git -C "$APP_REPO_DIR" fetch --all --prune || true
  git -C "$APP_REPO_DIR" checkout "${app_repo_branch}" || true
  git -C "$APP_REPO_DIR" pull --ff-only origin "${app_repo_branch}" || true
else
  echo "Cloning repository..."
  git clone --branch "${app_repo_branch}" --single-branch "${app_repo_url}" "$APP_REPO_DIR"
fi

if id ubuntu >/dev/null 2>&1; then
  chown -R ubuntu:ubuntu "$APP_DIR"
fi

SCRIPT_PATH=""
if [ -f "$APP_REPO_DIR/app/bootstrap-ec2-manual.sh" ]; then
  SCRIPT_PATH="$APP_REPO_DIR/app/bootstrap-ec2-manual.sh"
elif [ -f "$APP_REPO_DIR/bootstrap-ec2-manual.sh" ]; then
  SCRIPT_PATH="$APP_REPO_DIR/bootstrap-ec2-manual.sh"
fi

if [ -n "$SCRIPT_PATH" ]; then
  chmod +x "$SCRIPT_PATH"
  ln -sf "$SCRIPT_PATH" "$APP_DIR/bootstrap-ec2-manual.sh"
  echo "Manual script ready at: $APP_DIR/bootstrap-ec2-manual.sh"
else
  echo "WARNING: bootstrap-ec2-manual.sh not found in cloned repository."
fi

echo "========== MINIMAL USER DATA COMPLETE =========="
echo "Completed at: $(date)"
