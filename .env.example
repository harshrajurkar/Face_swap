# Face Swap Pipeline - Environment Configuration
# Copy this to .env and adjust for your system

# ===== BASIC SETTINGS =====
APP_NAME="AI Face Swap"
HOST=0.0.0.0
PORT=8000

# ===== REDIS & QUEUE =====
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=face_swap_jobs

# ===== STORAGE =====
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs
OUTPUT_URL_PREFIX=/outputs

# ===== FACE DETECTION =====
# InsightFace model settings
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_MODEL_DIR=models
FACE_DETECTION_SIZE=320  # Lower = faster, higher = more accurate

# ===== FACE SWAP =====
# Main face swap model (inswapper)
INSWAPPER_MODEL_PATH=models/inswapper_128.onnx
INSWAPPER_MODEL_URL=https://huggingface.co/ezioruan/inswapper_128.onnx/resolve/main/inswapper_128.onnx

# ===== FACE ENHANCEMENT (Optional) =====
# GFPGAN model for post-processing enhancement
GFPGAN_MODEL_PATH=models/GFPGANv1.3.pth
GFPGAN_MODEL_URL=https://github.com/TencentARC/GFPGAN/releases/download/v1.3.0/GFPGANv1.3.pth

# ===== EXECUTION =====
# CPU or GPU execution
# Options: "CPUExecutionProvider" (CPU) or "CUDAExecutionProvider" (GPU)
EXECUTION_PROVIDER=CPUExecutionProvider

# ===== NEW: FACE REGION PROCESSING (OPTIMIZED) =====

# Enable region-based processing (RECOMMENDED for low-resource systems)
# true = Process only face region (~60% less memory, ~70% less CPU)
# false = Process entire image (original behavior, uses more resources)
ENABLE_FACE_REGION_PROCESSING=true

# Face processing resolution
# 512 = Faster, lower memory (recommended for 8GB RAM)
# 768 = Better quality, more memory (for better systems)
FACE_PROCESSING_SIZE=512

# Padding around detected face (as ratio of face size)
# 0.3 = Tight (faster, less padding)
# 0.4 = Balanced (DEFAULT - good quality/speed balance)
# 0.5 = Loose (more padding, smoother blend but slower)
FACE_PADDING_RATIO=0.4

# Feathering width for seamless blending (pixels)
# 30 = Fast, minimal blending
# 40 = Balanced (DEFAULT - good balance)
# 60 = Smooth, stronger feathering (slower)
FACE_BLEND_WIDTH=40

# Debug mode: Save intermediate processing steps
# true = Save _01_cropped.jpg, _02_swapped.jpg for troubleshooting
# false = Disable (default, faster)
DEBUG_SAVE_INTERMEDIATES=false

# ===== JOB PROCESSING =====
JOB_STATUS_TTL_SECONDS=86400  # 24 hours
WORKER_CONCURRENCY=1          # Number of concurrent jobs
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_JOB_TIMEOUT_SECONDS=900  # 15 minutes
WORKER_MAX_RETRIES=2

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== CPU THREAD LIMITS (CRITICAL FOR LOW-RESOURCE SYSTEMS) =====
# Limit to prevent system overload
# Set to: CPU_COUNT / 2 (e.g., 4-core CPU → set to 2)
# Prevents all cores from being used simultaneously

# OpenMP (used by many ML libraries)
OMP_NUM_THREADS=4

# Intel Math Kernel Library
MKL_NUM_THREADS=4

# OpenBLAS (linear algebra)
OPENBLAS_NUM_THREADS=4

# NumExpr (numerical expressions)
NUMEXPR_NUM_THREADS=4

# ===== RECOMMENDED PRESETS =====
# For 8GB RAM, 4-core CPU:
#   FACE_PROCESSING_SIZE=512
#   FACE_BLEND_WIDTH=40
#   OMP_NUM_THREADS=2
#   WORKER_CONCURRENCY=1

# For 16GB RAM, 8-core CPU:
#   FACE_PROCESSING_SIZE=768
#   FACE_BLEND_WIDTH=50
#   OMP_NUM_THREADS=4
#   WORKER_CONCURRENCY=2

# For 32GB+ RAM, high-end CPU:
#   FACE_PROCESSING_SIZE=768
#   FACE_BLEND_WIDTH=60
#   OMP_NUM_THREADS=8
#   WORKER_CONCURRENCY=4
